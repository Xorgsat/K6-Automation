# ====================================================================
# QuickPizza Performance Engineering Framework: Environment Configuration
# ====================================================================

# Base URL for QuickPizza target (default is local docker instance)
BASE_URL=http://localhost:3333

# Prometheus metric endpoints
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_REMOTE_WRITE_URL=http://localhost:9090/api/v1/write

# Grafana URL
GRAFANA_URL=http://localhost:3000

# Execution Environment: local | ci
TEST_ENV=local

# Default Workload Profile: smoke | load | stress | spike | soak | regression
WORKLOAD_PROFILE=smoke

# Safety override (must be explicitly true to run against non-localhost targets)
ALLOW_EXTERNAL_TARGET=false

# Default request timeout
REQUEST_TIMEOUT=10s

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
